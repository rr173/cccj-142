#!/usr/bin/env python3
"""命令行启动包装：显式把包所在目录加入 sys.path，保证 ``python3 -I`` 可用。

用法：
  python3 -I bin/csv-ingest --input-dir DIR --manifest DIR/manifest.json \
      --output-dir OUT [--batch-size N] [--force] [--keep-db]
"""

import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
_PKG_PARENT = os.path.dirname(_HERE)
if _PKG_PARENT not in sys.path:
    sys.path.insert(0, _PKG_PARENT)

from csv_ingest.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
